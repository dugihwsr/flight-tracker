# Copy to .env. Everything is optional; defaults use free, keyless sources.
DEMO_MODE=false
TRACK_PROVIDERS=adsb,opensky
REGION_PROVIDERS=adsb,opensky
ADSB_API_BASE=https://api.adsb.lol
# Free OpenSky account -> API client (much higher limits than anonymous)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_GLOBAL_TTL=300
ROUTE_API_BASE=https://api.adsbdb.com
# Optional: schedule/delay/gate data (free tier ~100 req/month)
AVIATIONSTACK_API_KEY=
SCHEDULE_TTL=21600
POLL_INTERVAL=20
REGION_INTERVAL=30
MAX_TRACKED=10
MAX_REGION_FLIGHTS=2500
LOST_AFTER=300

# --- Free-plan budgeting (all optional) ---
# Defaults: OpenSky 400 credits/day anonymous, 4000 with a client id; AviationStack 100 requests/month.
# Set these if your plan differs. 0 = keep the default / no limit.
OPENSKY_DAILY_LIMIT=0
ADSB_DAILY_LIMIT=0
ROUTE_DAILY_LIMIT=0
AVIATIONSTACK_MONTHLY_LIMIT=100
# Minimum seconds between requests to hosts with no published quota (adsb.lol, adsbdb) - a floor on
# request *rate*, independent of the daily counters above. Raise these if you still hit rate limits.
ADSB_MIN_INTERVAL=1.0
ROUTE_MIN_INTERVAL=0.5
